# Copy to .env at the repository root (Docker Compose reads this file) or to
# backend/.env for local development. Never commit a real .env.
#
# Nested settings use a double underscore: CODEPILOT_<SECTION>__<FIELD>.

# --- Application -----------------------------------------------------------
CODEPILOT_APP_NAME=CodePilot AI
CODEPILOT_ENVIRONMENT=development
CODEPILOT_DEBUG=false

# --- HTTP server -----------------------------------------------------------
CODEPILOT_SERVER__HOST=0.0.0.0
CODEPILOT_SERVER__PORT=8000
# JSON list. Keep empty unless a browser/webview calls the API directly.
CODEPILOT_SERVER__CORS_ORIGINS=[]
CODEPILOT_SERVER__HEALTH_TIMEOUT_SECONDS=2

# --- PostgreSQL ------------------------------------------------------------
# Keep the port in sync with POSTGRES_PORT below, and use the host-mapped port
# when the backend runs outside Docker.
CODEPILOT_DATABASE__URL=postgresql+asyncpg://codepilot:codepilot_dev_password@localhost:5432/codepilot
CODEPILOT_DATABASE__POOL_SIZE=10
CODEPILOT_DATABASE__MAX_OVERFLOW=10
CODEPILOT_DATABASE__ECHO=false
CODEPILOT_DATABASE__CONNECT_TIMEOUT_SECONDS=5

# --- Qdrant ----------------------------------------------------------------
CODEPILOT_VECTOR_DB__URL=http://localhost:6333
# CODEPILOT_VECTOR_DB__API_KEY=
CODEPILOT_VECTOR_DB__TIMEOUT_SECONDS=5

# --- Logging ---------------------------------------------------------------
CODEPILOT_LOGGING__LEVEL=INFO
# console | json
CODEPILOT_LOGGING__FORMAT=console

# --- PostgreSQL container (docker/compose.yaml only) -----------------------
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot_dev_password
POSTGRES_DB=codepilot
# Host port for the PostgreSQL container. Change to 55432 (and update
# CODEPILOT_DATABASE__URL above) when a native PostgreSQL service already
# listens on 5432.
POSTGRES_PORT=5432
